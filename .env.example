# Public site origin used inside the voucher QR code and Stripe return URL. No trailing slash.
PUBLIC_SITE_URL=http://localhost:3010

# Postgres. Docker Compose overrides this for the web container.
DATABASE_URL=postgres://paints:paints@localhost:5435/letsallpaints
POSTGRES_PASSWORD=paints

# Seat cap for Eat, Drink & Paint. Remaining places are not shown as a live counter.
EVENT_CAPACITY=80

# Created on startup if missing. Password must be at least 8 characters.
# Changing ADMIN_PASSWORD and restarting updates the stored hash.
# ADMIN_ROLE seeds the bootstrap account: owner (default), editor, or door.
ADMIN_EMAIL=admin@letsallpaints.com
ADMIN_PASSWORD=change-me-now
ADMIN_ROLE=owner
ADMIN_SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

# Stripe secret key (sk_test_... or sk_live_...). Webhook signing secret from the dashboard
# or from: stripe listen --forward-to localhost:3010/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Inbox for guest replies and organiser booking notices.
SUPPORT_EMAIL=hello@letsallpaints.com
BOOKING_NOTIFY_EMAIL=hello@letsallpaints.com

# Optional public social profile URLs (shown in the footer when set).
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=

# SMTP. Leave SMTP_HOST empty to save emails under data/outbox without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Let's All Paints <bookings@letsallpaints.com>"
